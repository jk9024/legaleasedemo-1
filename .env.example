# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LegalEase
NODE_ENV=development

# Database (Neon)
DATABASE_URL=postgresql://user:pass@host/legalease

# NextAuth
NEXTAUTH_SECRET=
